[vault]
address=https://vault.domain.tld:8200
verify_tls=yes
deploy_user=root
deploy_group=ssl-cert

[approle]
role_id=<changeme>
secret_id=<changeme>

[storage]
path=/etc/ssl-certificates

# Optional: directory containing executable post-deploy hook scripts.
# Hooks are run only when at least one certificate file actually changed.
# If this section is omitted the scripts fall back to their built-in defaults:
#   vault-certificate-deploy       -> /etc/edrive/vault-certificate-deploy/post-hooks.d
#   vault-certificate-issue-deploy -> /etc/edrive/vault-certificate-deploy/post-issue-hooks.d
#[hooks]
#post_hooks_dir=/etc/edrive/certificate-hooks.d
